# Copy to .env and fill in. Never commit .env.
# Empty values are fine — the morning brief and the Polymarket bot both run without keys.

ALPHA_VANTAGE_KEY=demo

# --- Polymarket US bot (agent/) ---
# Venue: us = polymarket.us. Anything else keeps the legacy polygon path.
POLYMARKET_VENUE=us
POLYMARKET_BANKROLL=95

# API key id and secret from https://polymarket.us/developer
# Both must be set before live trading is possible. Keys alone do NOT place orders.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# Live trading is opt-in. Set to 1, true, or yes to place real orders.
# Also requires both keys above. Leave unset to stay in paper mode.
# POLYMARKET_PAPER=1 forces paper even when this is set.
POLYMARKET_LIVE=

# Force paper mode. Overrides POLYMARKET_LIVE. Accepts 1, true, or yes.
# POLYMARKET_PAPER=1

# Legacy polymarket.com signer. Not used when POLYMARKET_VENUE=us.
# On the polygon venue, a key longer than 10 characters still enables live
# unless POLYMARKET_PAPER is set. POLYMARKET_LIVE is not required there.
# POLYMARKET_PRIVATE_KEY=

# --- Gimme bets (paper by default; does not turn on live trading) ---
# Skip every crypto price slug (cpc-btc-..., cpceth-, cpcsol-, cpcxrp-, ...).
# Set to an empty value to stop skipping slugs. Crypto still will not trade
# until a probability model exists for it.
# US_GIMME_SKIP_SLUG_REGEX=^cpc
# Favorite test is the midpoint of a two-sided book, not the ask.
# US_GIMME_PRICE_THRESHOLD=0.92
# Widest bid-ask allowed on the side we would buy.
# US_GIMME_MAX_SPREAD=0.04
# Own model must clear the ask by this much AFTER the taker fee 0.0695*p*(1-p).
# US_GIMME_MIN_EDGE=0.03
# Skip markets that resolve sooner than this many hours.
# US_GIMME_MIN_HOURS=6
# Combined cap for every crypto underlying (BTC/ETH/SOL/XRP), as a fraction of bankroll.
# MAX_CRYPTO_EXPOSURE_PCT=0.05
